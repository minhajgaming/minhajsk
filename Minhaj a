
<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>GAMER ZONE - Zombie Survival</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#080d12;color:white;font-family:Arial;text-align:center;overflow:hidden;touch-action:none}
header{height:55px;background:#111d29;display:flex;align-items:center;justify-content:space-around}
h2{color:#00edb0;margin:0;font-size:20px}
a{color:#00eaff;text-decoration:none}
#hud{height:52px;display:flex;justify-content:space-around;align-items:center;background:#17222d;font-weight:bold;font-size:14px}
#health{color:#ff5656}
#ammo{color:#ffd45b}
#game{position:relative;width:100%;height:calc(100dvh - 107px);min-height:350px;background:#18251c}
canvas{width:100%;height:100%;display:block}
#controls{position:absolute;bottom:15px;left:0;right:0;display:flex;justify-content:space-between;align-items:end;padding:0 18px;pointer-events:none}
#stick{width:115px;height:115px;border-radius:50%;background:#ffffff25;border:3px solid #ffffff88;position:relative;pointer-events:auto;touch-action:none}
#knob{position:absolute;width:48px;height:48px;border-radius:50%;background:#c8e5e0;left:30px;top:30px}
#fire{width:90px;height:90px;border-radius:50%;background:#c92525;border:4px solid #ff7777;color:white;font-weight:bold;font-size:18px;pointer-events:auto;touch-action:none}
#reload{position:absolute;right:22px;bottom:115px;padding:10px 15px;border:0;border-radius:10px;background:#d49b19;color:#111;font-weight:bold}
#overlay{position:absolute;inset:0;background:#000d;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:12px;padding:20px}
#overlay h1{color:#00edb0}
#overlay button{padding:14px 30px;background:#00dca5;border:0;border-radius:12px;font-size:19px;font-weight:bold}
.small{font-size:13px;color:#ddd;line-height:1.7}
</style>
</head>
<body>

<header>
<a href="index.html">← HOME</a>
<h2>🧟 ZOMBIE SURVIVAL</h2>
</header>

<div id="hud">
<span id="health">❤️ 100</span>
<span id="score">🏆 0</span>
<span id="ammo">🔫 12/12</span>
</div>

<div id="game">
<canvas id="c"></canvas>

<div id="controls">
<div id="stick"><div id="knob"></div></div>
<button id="fire">FIRE 🔫</button>
</div>
<button id="reload">RELOAD ↻</button>

<div id="overlay">
<h1>🧟 ZOMBIE ATTACK</h1>
<p>বেঁচে থাকো, জম্বিদের মেরে স্কোর বাড়াও!</p>
<p class="small">বাম দিকের Joystick দিয়ে চলাফেরা করো।<br>FIRE চেপে গুলি করো।<br>R চাপলে Reload হবে।</p>
<button id="start">START GAME</button>
</div>
</div>

<script>
const canvas=document.getElementById("c");
const ctx=canvas.getContext("2d");
const game=document.getElementById("game");

let W=0,H=0;
function resize(){
 W=canvas.width=game.clientWidth;
 H=canvas.height=game.clientHeight;
}
window.addEventListener("resize",resize);
resize();

let player,zombies,bullets,particles;
let score=0,health=100,ammo=12;
let running=false,fire=false;
let spawnTime=0,last=0,shootTime=0,damageTime=0;
let moveX=0,moveY=0;
let keys={};

function reset(){
 player={x:W/2,y:H/2,r:17,speed:230};
 zombies=[];bullets=[];particles=[];
 score=0;health=100;ammo=12;
 spawnTime=0;shootTime=0;damageTime=0;
 moveX=0;moveY=0;
 updateHUD();
}

function updateHUD(){
 document.getElementById("health").textContent="❤️ "+Math.max(0,Math.floor(health));
 document.getElementById("score").textContent="🏆 "+score;
 document.getElementById("ammo").textContent="🔫 "+ammo+"/12";
}

function startGame(){
 reset();
 running=true;
 document.getElementById("overlay").style.display="none";
 last=0;
}
document.getElementById("start").onclick=startGame;

function spawnZombie(){
 let side=Math.floor(Math.random()*4),x,y;
 if(side===0){x=Math.random()*W;y=-30}
 if(side===1){x=W+30;y=Math.random()*H}
 if(side===2){x=Math.random()*W;y=H+30}
 if(side===3){x=-30;y=Math.random()*H}
 zombies.push({x,y,r:17,speed:35+Math.random()*25+score*.04,hp:1});
}

function nearest(){
 let target=null,best=Infinity;
 for(let z of zombies){
  let d=Math.hypot(z.x-player.x,z.y-player.y);
  if(d<best){best=d;target=z}
 }
 return target;
}

function shoot(){
 if(!running||ammo<=0)return;
 let target=nearest();
 if(!target)return;
 let dx=target.x-player.x,dy=target.y-player.y;
 let d=Math.hypot(dx,dy)||1;
 bullets.push({x:player.x,y:player.y,vx:dx/d*560,vy:dy/d*560,life:1.3});
 ammo--;
 shootTime=.18;
 updateHUD();
}

function reload(){
 if(!running||ammo===12)return;
 ammo=12;
 updateHUD();
}
document.getElementById("reload").onclick=reload;

function endGame(){
 running=false;
 fire=false;
 document.getElementById("overlay").style.display="flex";
 document.getElementById("overlay").innerHTML=
 '<h1>💀 GAME OVER</h1><h2>তোমার স্কোর: '+score+'</h2><p>আরও চেষ্টা করো!</p><button onclick="startGame()">PLAY AGAIN</button><p><a href="index.html">HOME</a></p>';
}

function circle(x,y,r,color){
 ctx.fillStyle=color;
 ctx.beginPath();ctx.arc(x,y,r,0,Math.PI*2);ctx.fill();
}

function drawBackground(){
 ctx.fillStyle="#1b3024";ctx.fillRect(0,0,W,H);
 ctx.strokeStyle="#ffffff0d";ctx.lineWidth=1;
 for(let x=0;x<W;x+=45){
  ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,H);ctx.stroke();
 }
 for(let y=0;y<H;y+=45){
  ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(W,y);ctx.stroke();
 }
 // রাস্তার অংশ
 ctx.fillStyle="#303b3c";
 ctx.fillRect(W*.12,H*.30,W*.76,H*.4);
 ctx.strokeStyle="#a6a6a655";
 ctx.setLineDash([20,20]);
 ctx.beginPath();ctx.moveTo(0,H*.5);ctx.lineTo(W,H*.5);ctx.stroke();
 ctx.setLineDash([]);
}

function drawPlayer(){
 ctx.save();
 ctx.translate(player.x,player.y);
 ctx.fillStyle="#111";
 ctx.fillRect(-10,-10,20,25);
 circle(0,-13,12,"#e3c29a");
 ctx.fillStyle="#21b9ff";
 ctx.fillRect(-13,-5,26,22);
 ctx.fillStyle="#333";
 ctx.fillRect(-8,13,7,10);
 ctx.fillRect(2,13,7,10);
 // বন্দুক
 let target=nearest(),angle=target?Math.atan2(target.y-player.y,target.x-player.x):0;
 ctx.rotate(angle);
 ctx.fillStyle="#bbb";ctx.fillRect(3,-4,25,8);
 ctx.fillStyle="#333";ctx.fillRect(10,-2,12,4);
 ctx.restore();
}

function drawZombie(z){
 ctx.save();ctx.translate(z.x,z.y);
 circle(0,0,z.r,"#497d42");
 circle(-6,-4,3,"#ff3030");
 circle(6,-4,3,"#ff3030");
 ctx.fillStyle="#142616";
 ctx.fillRect(-10,7,20,5);
 ctx.strokeStyle="#315b2e";ctx.lineWidth=5;
 ctx.beginPath();ctx.moveTo(-12,4);ctx.lineTo(-23,12);
 ctx.moveTo(12,4);ctx.lineTo(23,12);ctx.stroke();
 ctx.restore();
}

function update(dt){
 if(!running)return;

 let dx=moveX,dy=moveY;
 if(keys.ArrowLeft||keys.a)dx-=1;
 if(keys.ArrowRight||keys.d)dx+=1;
 if(keys.ArrowUp||keys.w)dy-=1;
 if(keys.ArrowDown||keys.s)dy+=1;
 let len=Math.hypot(dx,dy);
 if(len>1){dx/=len;dy/=len;}

 player.x=Math.max(20,Math.min(W-20,player.x+dx*player.speed*dt));
 player.y=Math.max(25,Math.min(H-25,player.y+dy*player.speed*dt));

 spawnTime+=dt;
 if(spawnTime>Math.max(.45,1.5-score/500)){
  spawnZombie();spawnTime=0;
 }

 shootTime-=dt;
 if(fire&&shootTime<=0){
  if(ammo>0)shoot();
  else shootTime=.5;
 }

 for(let z of zombies){
  let x=player.x-z.x,y=player.y-z.y;
  let d=Math.hypot(x,y)||1;
  z.x+=x/d*z.speed*dt;
  z.y+=y/d*z.speed*dt;
  if(d<z.r+player.r&&Date.now()-damageTime>650){
   health-=10;damageTime=Date.now();updateHUD();
   if(health<=0){endGame();return;}
  }
 }

 for(let b of bullets){
  b.x+=b.vx*dt;b.y+=b.vy*dt;b.life-=dt;
  for(let z of zombies){
   if(!z.dead&&Math.hypot(b.x-z.x,b.y-z.y)<z.r+5){
    z.dead=true;b.life=0;score+=10;
    updateHUD();
    break;
   }
  }
 }
 bullets=bullets.filter(b=>b.life>0&&b.x>-20&&b.x<W+20&&b.y>-20&&b.y<H+20);
 zombies=zombies.filter(z=>!z.dead);
}

function draw(){
 drawBackground();
 if(!player)return;

 for(let z of zombies)drawZombie(z);
 for(let b of bullets){
  circle(b.x,b.y,5,"#ffe35a");
  circle(b.x,b.y,2,"#fff");
 }
 drawPlayer();

 for(let p of particles){
  circle(p.x,p.y,3,"#ffbd42");
 }
}

function loop(t){
 requestAnimationFrame(loop);
 let dt=Math.min((t-last)/1000||0,.04);
 last=t;
 update(dt);
 draw();
}
requestAnimationFrame(loop);

// Mobile joystick
const stick=document.getElementById("stick");
const knob=document.getElementById("knob");
let stickId=null;

stick.addEventListener("pointerdown",e=>{
 stickId=e.pointerId;
 stick.setPointerCapture(e.pointerId);
 joystick(e);
});
stick.addEventListener("pointermove",e=>{
 if(e.pointerId===stickId)joystick(e);
});
function joystick(e){
 const r=stick.getBoundingClientRect();
 let x=e.clientX-(r.left+r.width/2);
 let y=e.clientY-(r.top+r.height/2);
 let d=Math.hypot(x,y),max=34;
 if(d>max){x=x/d*max;y=y/d*max}
 moveX=x/max;moveY=y/max;
 knob.style.left=(30+x)+"px";
 knob.style.top=(30+y)+"px";
}
function releaseStick(){
 stickId=null;moveX=0;moveY=0;
 knob.style.left="30px";knob.style.top="30px";
}
stick.addEventListener("pointerup",releaseStick);
stick.addEventListener("pointercancel",releaseStick);

// Fire button
const fireButton=document.getElementById("fire");
fireButton.addEventListener("pointerdown",e=>{
 e.preventDefault();fire=true;fireButton.setPointerCapture(e.pointerId);
});
["pointerup","pointercancel","lostpointercapture"].forEach(ev=>{
 fireButton.addEventListener(ev,()=>fire=false);
});

window.addEventListener("keydown",e=>{
 keys[e.key]=true;
 if(e.key.toLowerCase()==="r")reload();
});
window.addEventListener("keyup",e=>keys[e.key]=false);
</script>
</body>
</html>
